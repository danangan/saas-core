# Backend (local development). Copy to .env.

# Listen address. Keep on localhost: only the UI server should reach the backend.
HOST="127.0.0.1"
PORT="4000"

# Postgres. The app connects as the restricted saas_app role; migrations run as the owner.
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="saas"
DB_USERNAME="saas_app"
DB_PASSWORD="saas_app"
DB_MIGRATION_USERNAME="saas"
DB_MIGRATION_PASSWORD="saas"

# Public URL of the UI. Used for links in emails and as the only allowed browser origin.
APP_URL="http://localhost:3000"

# Email (Mailpit locally: read captured mail at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SaaS Core <no-reply@saas-core.local>"
