{
  "name": "@saas-core/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs api worker",
    "dev:api": "tsx watch --env-file=.env src/api/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @saas-core/shared db:generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/swagger": "^9.9.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@saas-core/shared": "workspace:*",
    "croner": "10.0.1",
    "fastify": "^5",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7",
    "dotenv": "^17",
    "openapi-types": "^12.1.3",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "tsup": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
